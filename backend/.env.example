# ────────────────────────────────────────────────────────────
# StructuraNet Backend Environment
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO=mongodb://localhost:27017/structuranet
# Optional: helps Node resolve mongodb+srv Atlas URIs when the OS resolver fails.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=replace_me_with_random_hex
JWT_REFRESH_SECRET=replace_me_with_random_hex

# Token Expiries
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# LLM (OpenRouter)
ROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/owl-alpha
AI_MAX_TOKENS=6000

# AI Engine Bridge
WRAPPER_PATH=../ai-engine/wrapper.py
PYTHON_BIN=python
OUTPUT_DIR=./output

# Payments (Stripe Checkout)
# Set PAYMENTS_DEV_MODE=true to test upgrades without Stripe keys.
PAYMENTS_DEV_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173/plans?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/plans?checkout=cancel

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
